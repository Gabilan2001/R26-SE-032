    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "babel-preset-expo": "^57.0.7"
  },
  "private": true
