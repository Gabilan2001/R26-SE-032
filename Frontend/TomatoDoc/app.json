{
  "expo": {
    "name": "TomatoDoc",
    "slug": "tomatodoc",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0F0F0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.tomatodoc.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0F0F0"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "TomatoDoc needs access to your photos so you can pick a leaf or fruit picture to scan.",
          "cameraPermission": "TomatoDoc needs the camera so you can take a photo of a leaf or fruit to scan."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "a69e0b86-585f-4439-a76a-3755f4dd2ce4"
      }
    }
  }
}
