{
  "expo": {
    "name": "TomatoDoc",
    "slug": "tomatodoc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0F0F0"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true },
    "android": {
      "package": "com.tomatodoc.app",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0F0F0"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "TomatoDoc needs access to your photos so you can pick a leaf or fruit picture to scan.",
          "cameraPermission": "TomatoDoc needs the camera so you can take a photo of a leaf or fruit to scan."
        }
      ]
    ],
    "web": { "bundler": "metro" }
  }
}
