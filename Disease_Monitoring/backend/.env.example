# Copy to .env and fill in locally. Never commit real keys.

# OpenWeather (location reverse-geocode + weather context)
WEATHER_API_KEY=
OPENWEATHER_API_KEY=

# Hidden secondary image verification (backend only — never expose to frontend)
GEMINI_API_KEY=
# The fruit/leaf model paths default to the tracked files under datasets/.
# Override only with a path that exists in the deployed backend container.
# FRUIT_SEVERITY_MODEL_PATH=datasets/fruit_severity_cnn.pth
# Optional overrides:
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_SEC=20
