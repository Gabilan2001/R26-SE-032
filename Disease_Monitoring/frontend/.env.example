# Your PC's IP (ipconfig → active adapter IPv4). Used for phone / Expo Go.
EXPO_PUBLIC_API_HOST=192.168.0.1
EXPO_PUBLIC_API_PORT=8000

# Browser (`npm run web`) uses localhost by default. Override if needed:
# EXPO_PUBLIC_API_HOST_WEB=127.0.0.1

# lan | tunnel — use tunnel if Expo Go times out (phone hotspot / firewall)
EXPO_CONNECTION=tunnel

# Metro port (optional; default 8001)
# EXPO_METRO_PORT=8001
